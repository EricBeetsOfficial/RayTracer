<scene>
    <materials>
        <material name="material-diffuse-red" enable="1">
            <diffuse>0.9 0 0</diffuse>
            <specular>1 1 1</specular>
            <shininess>30</shininess>
            <reflective>0</reflective>
            <transparency>0</transparency>
        </material>
        <material name="material-transparent" enable="1">
            <diffuse>1 1 1</diffuse>
            <specular>1 1 1</specular>
            <shininess>30</shininess>
            <reflective>0.1</reflective>
            <transparency>0.7</transparency>
        </material>
        <material name="material-reflective" enable="1">
            <diffuse>0.8 1 0.8</diffuse>
            <specular>1 1 1</specular>
            <shininess>30</shininess>
            <reflective>0.1</reflective>
            <transparency>0.5</transparency>
        </material>
        <material name="material-diffuse-white" enable="1">
            <diffuse>1 1 1</diffuse>
            <specular>1 1 1</specular>
            <shininess>30</shininess>            
            <reflective>0</reflective>
            <transparency>0</transparency>
        </material>
    </materials>
    <geometries>
        <sphere name="sphere-diffuse" material="#material-diffuse-red" enable="1">
            <radius>30</radius>
            <position>0 27 -350</position>
        </sphere>
        <sphere name="sphere-transparente" material="#material-reflective" enable="1">
            <radius>25</radius>
            <position>-70 20 -450</position>
        </sphere>
        <sphere name="sphere-transparente-front" material="#material-transparent" enable="1">
            <radius>20</radius>
            <position>15 20 -310</position>
        </sphere>
        <plane name="plane-bottom" material="#material-diffuse-white" enable="1">
            <normal>0 1 0</normal>
            <size>0</size>
            <position>0 0 0</position>
        </plane>
        <plane name="plane-back" material="#material-diffuse-white" enable="1">
            <normal>0 0 1</normal>
            <size>0</size>
            <position>0 0 -800</position>
        </plane>
        <plane name="plane-right" material="#material-diffuse-white" enable="0">
            <normal>0 -1 0</normal>
            <size>0</size>
            <position>0 100 0</position>
        </plane>
    </geometries>
    <lights>
        <light name="light1" enable="1">
            <type>point</type>
            <shadow>true</shadow>
            <color>0.8 0.8 1</color>
            <position>60 60 -400</position>
        </light>
        <light name="light2" enable="1">
            <type>point</type>
            <shadow>true</shadow>
            <color>1 1 1 </color>
            <position>-60 60 -250</position>
        </light>
        <light name="light2" enable="1">
            <type>point</type>
            <shadow>true</shadow>
            <color>1 1 1 </color>
            <position>60 60 -250</position>
        </light>
    </lights>
    <cameras>
        <camera name="mainCamera" enable="1">
            <resolution>1080 720</resolution>
            <fov>60</fov>
            <position>-80 100 -150</position>
            <rotation>11 11 0</rotation>
        </camera>
    </cameras>
</scene>
